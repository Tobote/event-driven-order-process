# Copy to .env (same folder) and replace the placeholder values.
# .env is git-ignored; keep this file in sync when adding variables to docker-compose.yaml.
# Avoid generic names (USER, PASSWORD): shell variables override .env during substitution.

# PostgreSQL (credentials apply on first boot only; run `docker compose down -v` after changing them)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
# Databases created by postgres/init.sh on first boot (comma-separated, no spaces)
POSTGRES_MULTIPLE_DATABASES=orders,inventory,payments

# RabbitMQ (credentials apply on first boot only)
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=change-me

# Redis (applied on every start; `docker compose up -d` picks up a change)
REDIS_PASSWORD=change-me
